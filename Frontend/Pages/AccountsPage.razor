@page "/Accounts"
@inject HttpClient Http
@using Frontend.Models

<PageTitle>Accounts</PageTitle>

<div class="phone">
    <header class="topbar">
        <button class="icon-button" onclick="history.back()">←</button>
        <h2>ACCOUNTS</h2>
        <span></span>
    </header>

    <main class="screen-content">
        @if (users == null)
        {
            <p>Henter data...</p>
        }
        else if (users.Count == 0)
        {
            <p>Ingen konti fundet.</p>
        }
        else
        {
            <div class="account-list">
                @foreach (var account in users)
                {
                    <article class="account-card">
                        <div class="small-avatar">👤</div>
                        <div class="account-information">
                            <strong>@account.Firstname @account.Lastname</strong>
                            <span>@account.Streetname</span>
                        </div>
                        <button class="delete-button" @onclick="() => DeleteUser(account.Id)">×</button>
                    </article>
                }
            </div>
        }
    </main>

    <BottomNavigation />
</div>

@code {
    private List<UserDto>? users;

    protected override async Task OnInitializedAsync()
    {
        // Henter brugere via firstname — erstat med relevant søgning
        users = await Http.GetFromJsonAsync<List<UserDto>>("api/user/firstname/Vivek");
    }

    private async Task DeleteUser(string userId)
    {
        var response = await Http.DeleteAsync($"api/user/{userId}");
        if (response.IsSuccessStatusCode && users != null)
        {
            users.RemoveAll(u => u.Id == userId);
        }
    }
}
